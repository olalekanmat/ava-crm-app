{
  "expo": {
    "name": "Ava CRM",
    "slug": "ava",
    "version": "2.2.1",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.avacrm.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Ava CRM records your location when you check in to a call, so your visit can be verified.",
        "NSCameraUsageDescription": "Ava CRM uses the camera to take your profile picture.",
        "NSPhotoLibraryUsageDescription": "Ava CRM uses your photos to set your profile picture."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.avacrm.app",
      "versionCode": 6,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro",
      "name": "Ava CRM",
      "shortName": "Ava CRM",
      "themeColor": "#1846C8",
      "backgroundColor": "#F4F6FB",
      "description": "Ava CRM: field CRM for life-sciences sales teams"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Ava CRM uses your photos to set your profile picture.",
          "cameraPermission": "Ava CRM uses the camera to take your profile picture.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ava CRM records your location when you check in to a call, so your visit can be verified."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "expo-background-task"
    ],
    "scheme": [
      "ava",
      "com.avacrm.app"
    ]
  }
}
